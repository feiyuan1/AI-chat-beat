{
  "name": "@ai-chat-beat/app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@ai-chat-beat/common": "1.0.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~57.0.24",
    "expo-dev-client": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-webview": "^14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.12",
    "esbuild": "^0.28.2",
    "concurrently": "^9.2.1",
    "chokidar": "^5.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "chcp 65001 && concurrently \"npm run watch:common\" \"expo start --dev-client\"",
    "rc": "chcp 65001 && concurrently \"npm run watch:common\" \"npx expo start --dev-client --reset-cache\"",
    "watch:common": "node ./scripts/watch-common.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "private": true
}
