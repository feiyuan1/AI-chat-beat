{
  "compilerOptions": {
    "composite": true,
    "module": "esnext",
    "types": ["node"],
    "moduleResolution": "bundler",
    "target": "esnext",
    "outDir": "build",
    "rootDir": "src",
    "tsBuildInfoFile": "./build/tsconfig.tsbuildinfo",
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["**/**.d.ts"]
}
